datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum UserRole {
  USER
  ADMIN
}

enum TripStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

model User {
  id        String     @id @default(cuid())
  username  String     @unique
  email     String?     @unique
  emailVerifiedAt DateTime?
  firstName String?
  lastName  String?
  password  String
  role      UserRole   @default(USER)
  listings  Listing[]
  trips     Trip[]
  wishlists Wishlist[]
  sessions  Session[]
  reviews   Review[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Listing {
  id          String     @id @default(cuid())
  title       String
  description String?
  location     String
  locationType String
  placeType    String
  price        Int
  guests       Int        @default(1)
  bedrooms     Int        @default(1)
  rating       Float      @default(0)
  featured     Boolean    @default(false)
  active       Boolean    @default(true)
  mapData      Json?
  photos       Json?
  amenities    String[]   @default([])
  ownerId      String?
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  trips        Trip[]
  wishlists    Wishlist[]
  reviews      Review[]
  blocks       ListingBlock[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ownerId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
  @@index([listingId])
}

model Trip {
  id        String     @id @default(cuid())
  userId    String
  listingId String
  status    TripStatus @default(PENDING)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startsAt    DateTime?
  endsAt      DateTime?
  nightlyRate Int?
  nights      Int?
  totalPrice  Int?
  guests      Int?
  createdAt   DateTime @default(now())
  review    Review?
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listingId])
}


model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}


model Review {
  id        String   @id @default(cuid())
  tripId    String   @unique
  userId    String
  listingId String
  rating    Int
  comment   String?
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listingId])
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}


model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}


model ListingBlock {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([startsAt])
  @@index([endsAt])
}
